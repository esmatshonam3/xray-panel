# =============================================================================
#  Xray Panel - Control Plane environment variables
#  Copy to .env and fill in. NEVER commit the real .env file.
# =============================================================================

# --- General ----------------------------------------------------------------
APP_NAME=Xray Panel
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
# Public base URL of the panel (used for subscription links + Telegram webhook)
PANEL_BASE_URL=https://xray-panel.onrender.com

# --- Security ---------------------------------------------------------------
# 64+ random chars: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_64_random_characters_minimum
# Optional explicit Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())").
# If empty/invalid, a deterministic key is derived from SECRET_KEY.
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://xray-panel.onrender.com
TRUSTED_HOSTS=*

# --- Bootstrap superadmin (created on first boot, change password after) -----
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
SUPERADMIN_TELEGRAM_ID=

# --- Database ---------------------------------------------------------------
# Render Postgres injects a postgresql:// URL - it is normalised automatically.
# Local dev fallback:
DATABASE_URL=sqlite:///./data/panel.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Node agent -------------------------------------------------------------
NODE_REQUEST_TIMEOUT=15
NODE_VERIFY_TLS=true
NODE_HEARTBEAT_STALE_SECONDS=180

# --- Telegram bot -----------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_USERNAME=my_vpn_bot
# Random string Telegram sends back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_random_webhook_secret
# Comma separated numeric Telegram user IDs with admin rights in the bot
TELEGRAM_ADMIN_IDS=
# Set the webhook automatically on startup
TELEGRAM_AUTO_SET_WEBHOOK=true
TELEGRAM_PAYMENT_INSTRUCTIONS=Pay to card 0000-0000-0000-0000 then send the receipt photo here.

# --- Business rules ---------------------------------------------------------
DEFAULT_CURRENCY=USD
TRAFFIC_SYNC_INTERVAL_SECONDS=120
QUOTA_ENFORCEMENT_ENABLED=true
GRACE_PERIOD_HOURS=24
AUTO_DISABLE_ON_EXPIRY=true
ENABLE_SCHEDULER=true

# --- Backups ----------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- Alerts -----------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_CPU_THRESHOLD=90
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=90

# --- Web server -------------------------------------------------------------
PORT=8000
WEB_CONCURRENCY=1
